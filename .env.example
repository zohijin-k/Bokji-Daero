# Server-side only. Never prefix this variable with NEXT_PUBLIC_.
WELFARE_API_KEY=

# Copy the operation path from the official data.go.kr Swagger/guide.
# The operation/schema was not available in this workspace, so no default is guessed.
WELFARE_API_OPERATION=

# Optional additional query parameters as a JSON object, e.g. {"pageNo":"1"}
WELFARE_API_PARAMS={}

# Server-side OpenAI Responses API. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional. Defaults to gpt-6-astra; output is limited to 500 tokens per request.
OPENAI_MODEL=gpt-6-astra
